# The repository root .gitignore already covers node_modules/, .next/, out/, coverage/,
# playwright-report/, test-results/, .vercel and .DS_Store. App-specific entries only:

# yarn / pnp (create-next-app defaults)
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# production
/build

# misc
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# typescript
*.tsbuildinfo
next-env.d.ts
